{
  "name": "bolo-urdu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bolo Urdu — learn to speak conversational Urdu (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate-content": "vitest run tests/content.test.ts",
    "icons": "node scripts/gen-icons.mjs",
    "audio": "python scripts/gen_audio.py"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource/noto-nastaliq-urdu": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
