  "guide": [
    {
      "title": "Some words sound like English",
      "body": "Chai, lassi and roti are already used in English! Urdu also borrows English words — you'll hear \"phone\", \"bus\" and \"washroom\" every day.",
      "examples": [
        "v-chai",
        "v-roti"
      ]
    },
    {
      "title": "Two kinds of \"kh\"",
      "body": "Khaana (food) uses k + a puff of air. Khuda (God, in Khuda hafiz) uses a scrape in the throat. Listen to both and hear the difference.",
      "examples": [
        "v-khaana",
        "v-khudahafiz"
      ]
    },
    {
      "title": "Describing words",
      "body": "Words like garam (hot) and thanda (cold) describe things. Later you'll put them in front of food words: garam chai = hot tea — just like English.",
      "examples": [
        "v-garam",
        "v-thanda"
      ]
    }
  ]
