    {
      "id": "l5-present",
      "title": "What You Do & Are Doing",
      "objective": "Use \"-ta hoon\" for habits and \"raha hoon\" for things happening right now.",
      "tips": [
        "Habit: verb stem + ta/ti + hoon. \"Main chai peeta hoon\" = I drink tea (regularly).",
        "Happening now: verb stem + raha/rahi + hoon. \"Main chai pee raha hoon\" = I am drinking tea (now).",
        "Endings: -a / -i for one man / one woman, -e for plural or respectful aap: \"Aap kya kar rahe hain?\""
      ],
