  {
    "id": "pr-dental-retroflex-t",
    "title": "Two kinds of t",
    "focus": "Dental t (ت) vs retroflex ṭ (ٹ)",
    "tip": "English t is in between these two sounds, so neither is identical to English t. For dental t (ت), touch the back of your top front teeth with the tongue tip. For retroflex ṭ (ٹ), curl the tongue tip back and touch the roof of your mouth behind the ridge.",
    "items": [
      {
        "roman": "teen",
        "urdu": "تین",
        "en": "three",
        "guide": "dental t — tongue on teeth"
      },
      {
        "roman": "tum",
        "urdu": "تم",
        "en": "you (informal)",
        "guide": "dental t"
      },
      {
        "roman": "tamatar",
        "urdu": "ٹماٹر",
        "en": "tomato",
        "guide": "ṭamāṭar — both t's retroflex"
      },
      {
        "roman": "topi",
        "urdu": "ٹوپی",
        "en": "cap",
        "guide": "ṭopi — retroflex, tongue curled back"
      },
      {
        "roman": "theek",
        "urdu": "ٹھیک",
        "en": "fine / okay",
        "guide": "ṭh — retroflex with a puff of air"
      }
    ]
  },
  {
    "id": "pr-dental-retroflex-d",
    "title": "Two kinds of d",
    "focus": "Dental d (د) vs retroflex ḍ (ڈ)",
    "tip": "Same tongue positions as the two t's: dental d with the tongue on your teeth, retroflex ḍ with the tongue curled back. Neither is quite the English d.",
