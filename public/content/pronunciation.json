  {
    "id": "pr-rhythm",
    "title": "Rhythm in sentences",
    "focus": "Word stress and natural rhythm",
    "tip": "Urdu stress is lighter than English stress. Avoid shrinking unstressed vowels to \"uh\" the way English does. Give each syllable its full vowel, and let long vowels take a little more time.",
    "items": [
      {
        "roman": "Aap kaise hain?",
        "urdu": "آپ کیسے ہیں؟",
        "en": "How are you?",
        "guide": "aap KAI-se hãi — even beats"
      },
      {
        "roman": "Main theek hoon.",
        "urdu": "میں ٹھیک ہوں۔",
        "en": "I'm fine.",
        "guide": "mẽ ṭheek hū̃"
      },
      {
        "roman": "Mujhe samajh nahi aaya.",
        "urdu": "مجھے سمجھ نہیں آیا۔",
        "en": "I didn't understand.",
        "guide": "mu-jhe sa-majh na-hĩ aa-yaa"
      },
      {
        "roman": "Aahista boliye.",
        "urdu": "آہستہ بولیے۔",
        "en": "Please speak slowly.",
        "guide": "aa-his-taa bo-li-ye"
      }
    ]
  },
  {
    "id": "pr-connected",
    "title": "Connected speech",
    "focus": "Joining words smoothly",
    "tip": "In everyday speech, small words glue onto the word before them: \"aap ka\" sounds like \"aapka\", \"aap se\" like \"aapse\", \"mil kar\" like \"milkar\". Practise saying each phrase as one breath.",
