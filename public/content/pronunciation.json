  {
    "id": "pr-greetings",
    "title": "Saying everyday phrases smoothly",
    "focus": "Common greetings",
    "tip": "Say each phrase as one smooth unit, not word by word. Long vowels (aa, ee) are held a little longer than in English.",
    "items": [
      {
        "roman": "Suniye",
        "urdu": "سنیے",
        "en": "Excuse me / listen",
        "guide": "su-NI-ye — short u, stress the middle"
      },
      {
        "roman": "Ji, boliye",
        "urdu": "جی، بولیے",
        "en": "Yes, go ahead",
        "guide": "jee, BO-li-ye"
      },
      {
        "roman": "Shukriya",
        "urdu": "شکریہ",
        "en": "Thank you",
        "guide": "shuk-ri-yaa"
      },
      {
        "roman": "Khuda hafiz",
        "urdu": "خدا حافظ",
        "en": "Goodbye",
        "guide": "khu-DAA haa-fiz (kh = throaty خ)"
      },
      {
        "roman": "Aapse mil kar khushi hui",
        "urdu": "آپ سے مل کر خوشی ہوئی",
        "en": "Nice to meet you",
        "guide": "aap-se mil-kar khu-shi hu-i"
      }
    ]
  },
