  {
    "id": "pr-throat",
    "title": "Throat sounds",
    "focus": "kh (خ), gh (غ) and q (ق)",
    "tip": "Roman Urdu writes \"kh\" and \"gh\" for two different sounds each. خ (as in khush) is a rough, scraping sound at the back of the mouth, like Scottish \"loch\". غ (as in ghalat) is the voiced version, a little like a French r. ق (q) is a k made further back, deep in the throat. Many speakers relax q into k in casual speech.",
    "items": [
      {
        "roman": "khush",
        "urdu": "خوش",
        "en": "happy",
        "guide": "خ — scraping, like \"loch\""
      },
      {
        "roman": "khabar",
        "urdu": "خبر",
        "en": "news",
        "guide": "خ"
      },
      {
        "roman": "ghalat",
        "urdu": "غلط",
        "en": "wrong",
        "guide": "غ — gargled g"
      },
      {
        "roman": "qeemat",
        "urdu": "قیمت",
        "en": "price",
        "guide": "ق — k from deep in the throat"
      },
      {
        "roman": "qareeb",
        "urdu": "قریب",
        "en": "near",
        "guide": "ق"
      }
    ]
  },
  {
    "id": "pr-flap",
    "title": "The flapped ṛ",
    "focus": "ṛ (ڑ) vs r (ر)",
    "tip": "Ordinary r (ر) is a light tap of the tongue tip behind the teeth, a bit like the tt in American \"butter\". ڑ is a flap with the tongue curled back, flicking forward. It is not the English r.",
