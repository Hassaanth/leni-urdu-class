  "guide": [
    {
      "title": "Family words",
      "body": "Ammi and abbu are what most Pakistanis call their mum and dad. Bhai (brother) is also a friendly way to address any man.",
      "examples": [
        "v-ammi",
        "v-abbu",
        "v-bhai"
      ]
    },
    {
      "title": "\"My\" and \"your\"",
      "body": "Mera = my, aap ka = your. They go BEFORE the word, just like English: mera ghar = my home.",
      "examples": [
        "v-mera",
        "v-aapka"
      ]
    },
    {
      "title": "Don't worry about the script",
      "body": "Notice that Urdu script is written right-to-left. You don't need to read it yet — the Roman Urdu is enough to start speaking.",
      "examples": [
        "v-naam"
      ]
    }
  ]
