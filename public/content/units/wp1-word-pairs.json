  "guide": [
    {
      "title": "Describing word + thing",
      "body": "Like English, the describing word comes first: garam chai (hot tea), thanda paani (cold water).",
      "examples": [
        "v-garamchai",
        "v-thandapaani"
      ]
    },
    {
      "title": "mera / meri",
      "body": "My is mera for masculine words and meri for feminine words. Don't try to memorise lists — you'll get a feel for it.",
      "examples": [
        "v-meraghar",
        "v-meribehen"
      ]
    },
    {
      "title": "Being extra polite",
      "body": "Put ji in front of haan or nahi to be polite. Put bohat in front of shukriya to say \"thank you very much\".",
      "examples": [
        "v-jihaan",
        "v-bohatshukriya"
      ]
    }
  ]
