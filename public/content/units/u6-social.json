{
  "id": "u6",
  "level": 4,
  "title": "Natural Social Urdu",
  "description": "Make plans, share feelings and opinions, and sound relaxed with friends.",
  "lessons": [
    {
      "id": "l6-plans",
      "title": "Invitations & Plans",
      "objective": "Invite someone, accept or decline, and agree on a time.",
      "tips": [
        "Pakistani hospitality is warm: an invitation (\"Hamare ghar aaiye\") is often sincere. Saying \"Zaroor, Insha'Allah\" is a friendly reply.",
        "Everyday Urdu borrows many English words: plan, weekend, free, late. That's natural, not \"wrong\" Urdu."
      ],
      "phrases": [
        {
          "id": "p-kal-plan",
          "en": "What's the plan tomorrow?",
          "roman": "Kal kya plan hai?",
          "urdu": "کل کیا پلان ہے؟",
          "accept": [
            "kal ka kya plan hai",
            "kal kia plan hai"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-chalo-chai",
          "en": "Come on, let's have tea.",
          "roman": "Chalo, chai peete hain.",
          "urdu": "چلو، چائے پیتے ہیں۔",
          "accept": [
            "chalo chai pite hain",
            "chalo chai peetay hain"
          ],
          "note": "\"Chalo + verb-te hain\" is how you say \"let's...\".",
          "kind": "sentence"
        },
        {
          "id": "p-ghar-aaiye",
          "en": "Come to our home (please visit us).",
          "roman": "Hamare ghar aaiye.",
          "urdu": "ہمارے گھر آئیے۔",
          "accept": [
            "hamare ghar aaiye",
            "humare ghar aaiye",
            "hamare ghar aayen",
            "hamare ghar aaen"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-zaroor-aaunga",
          "en": "I'll definitely come.",
          "roman": "Zaroor aaunga.",
          "urdu": "ضرور آؤں گا۔",
          "accept": [
            "zarur aaunga",
            "zaroor aunga"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Zaroor aaunga.",
              "urdu": "ضرور آؤں گا۔"
            },
            "feminine": {
              "roman": "Zaroor aaungi.",
              "urdu": "ضرور آؤں گی۔"
            },
            "explain": "\"Aaunga\" for men, \"aaungi\" for women.",
            "by": "speaker"
          },
          "kind": "sentence"
        },
        {
          "id": "p-weekend-free",
          "en": "Are you free this weekend? (informal)",
          "roman": "Is weekend free ho?",
          "urdu": "اس ویک اینڈ فری ہو؟",
          "accept": [
            "is weekend free ho kya",
            "kya is weekend free ho"
          ],
          "note": "\"Ho\" goes with tum, so this is for friends. To be polite: \"Kya aap is weekend free hain?\"",
          "kind": "sentence"
        },
        {
          "id": "p-der-ho",
          "en": "I'll be late.",
          "roman": "Mujhe der ho jayegi.",
          "urdu": "مجھے دیر ہو جائے گی۔",
          "accept": [
            "mujhe der ho jaegi",
            "mujhe der ho jaye gi"
          ],
          "literal": "to me lateness will happen",
          "kind": "sentence"
        },
        {
          "id": "p-koi-masla-nahi",
          "en": "No problem.",
          "roman": "Koi masla nahi.",
          "urdu": "کوئی مسئلہ نہیں۔",
          "accept": [
            "koi masla nahin",
            "koi masla nai"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-phir-kabhi",
          "en": "Some other time.",
          "roman": "Phir kabhi.",
          "urdu": "پھر کبھی۔",
          "accept": [
            "fir kabhi"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-kitne-baje-milein",
          "en": "What time shall we meet?",
          "roman": "Kitne baje milein?",
          "urdu": "کتنے بجے ملیں؟",
          "accept": [
            "kitne baje milen",
            "kitne bajay milein"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-intezaar",
          "en": "I'll wait.",
          "roman": "Main intezaar karunga.",
          "urdu": "میں انتظار کروں گا۔",
          "accept": [
            "main intazar karunga",
            "main intezar karunga"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Main intezaar karunga.",
              "urdu": "میں انتظار کروں گا۔"
            },
            "feminine": {
              "roman": "Main intezaar karungi.",
              "urdu": "میں انتظار کروں گی۔"
            },
            "explain": "\"Karunga\" for men, \"karungi\" for women.",
            "by": "speaker"
          },
          "kind": "sentence"
        }
      ],
