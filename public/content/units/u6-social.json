    {
      "id": "l6-feelings",
      "title": "Feelings & Opinions",
      "objective": "Say how you feel and share or disagree with an opinion politely.",
      "tips": [
        "\"Mujhe lagta hai ke...\" (I think that...) is the easiest way to give an opinion.",
        "Disagreeing politely: start with something positive — \"Aap ki baat theek hai, lekin...\" (you have a point, but...)."
      ],
      "phrases": [
        {
          "id": "p-khush",
          "en": "I'm very happy.",
          "roman": "Main bohat khush hoon.",
          "urdu": "میں بہت خوش ہوں۔",
          "accept": [
            "main bahut khush hoon",
            "main bohot khush hoon",
            "main bohat khush hun"
          ],
          "note": "\"Khush\" doesn't change for gender. The kh is the throaty خ.",
          "kind": "sentence"
        },
        {
          "id": "p-pareshan",
          "en": "I'm worried / upset.",
          "roman": "Main pareshan hoon.",
          "urdu": "میں پریشان ہوں۔",
          "accept": [
            "main pareshaan hoon",
            "main preshan hoon"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-dukh-hua",
          "en": "I'm sorry to hear that. (lit. it made me sad)",
          "roman": "Mujhe sun kar dukh hua.",
          "urdu": "مجھے سن کر دکھ ہوا۔",
          "accept": [
            "mujhe sunkar dukh hua",
            "mujhe sun ke dukh hua"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-khayal-mein",
          "en": "In my opinion...",
          "roman": "Mere khayal mein...",
          "urdu": "میرے خیال میں...",
          "accept": [
            "mere khayal main",
            "mere khyal mein"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-lagta-hai",
          "en": "I think that...",
          "roman": "Mujhe lagta hai ke...",
          "urdu": "مجھے لگتا ہے کہ...",
          "accept": [
            "mujhe lagta hai ki",
            "mujhe lagta he ke"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-theek-keh",
          "en": "You're right.",
          "roman": "Aap theek keh rahe hain.",
          "urdu": "آپ ٹھیک کہہ رہے ہیں۔",
          "accept": [
            "aap theek kah rahe hain",
            "aap thik keh rahe hain"
          ],
          "note": "To a woman: \"Aap theek keh rahi hain.\"",
          "kind": "sentence"
        },
        {
          "id": "p-mutafiq",
          "en": "I don't agree.",
          "roman": "Main mutafiq nahi hoon.",
          "urdu": "میں متفق نہیں ہوں۔",
          "accept": [
            "main muttafiq nahi hoon",
            "main mutafiq nahin hoon"
          ],
          "note": "Fairly formal. In casual talk people often say \"Mujhe aisa nahi lagta\" (I don't think so).",
          "kind": "sentence"
        },
        {
          "id": "p-kamaal",
          "en": "Wow, amazing! (informal)",
          "roman": "Yaar, kamaal hai!",
          "urdu": "یار، کمال ہے!",
          "accept": [
            "yaar kamal hai",
            "yar kamaal hai"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-bohat-acha",
          "en": "Very good / Great",
          "roman": "Bohat acha",
          "urdu": "بہت اچھا",
          "accept": [
            "bahut acha",
            "bohat achha",
            "bohot acha",
            "bohat achcha"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-gussa",
          "en": "I'm getting angry.",
          "roman": "Mujhe gussa aa raha hai.",
          "urdu": "مجھے غصہ آ رہا ہے۔",
          "accept": [
            "mujhe ghussa aa raha hai",
            "mujhe gussa aa rha hai"
          ],
          "note": "\"Gussa\" starts with غ, a gargled g sound, though many people say a plain g.",
          "kind": "sentence"
        },
        {
          "id": "p-mubarak",
          "en": "Congratulations!",
          "roman": "Mubarak ho!",
          "urdu": "مبارک ہو!",
          "accept": [
