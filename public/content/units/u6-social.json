          "roman": "Masha'Allah",
          "urdu": "ماشاءاللہ",
          "accept": [
            "mashallah",
            "masha allah",
            "maashallah"
          ],
          "note": "Used when praising someone's child, home, success, etc.",
          "kind": "word"
