    {
      "id": "l6-casual",
      "title": "Casual Expressions",
      "objective": "Understand and use the small words that make conversation sound natural.",
      "tips": [
        "\"Yaar\" is everywhere among friends — like \"mate\" or \"dude\". Don't use it with elders or in formal settings.",
        "\"Acha\" has many jobs: \"good\", \"okay\", \"I see\", and with a rising tone, \"Really?\""
      ],
      "phrases": [
        {
          "id": "p-yaar",
          "en": "mate / buddy (informal)",
          "roman": "yaar",
          "urdu": "یار",
          "accept": [
            "yar"
          ],
          "kind": "word"
        },
        {
          "id": "p-acha",
          "en": "Okay / I see / Really?",
          "roman": "Acha",
          "urdu": "اچھا",
          "accept": [
            "achha",
            "accha",
            "achcha"
          ],
          "kind": "word"
        },
        {
          "id": "p-sach-mein",
          "en": "Really? / Seriously?",
          "roman": "Sach mein?",
          "urdu": "سچ میں؟",
          "accept": [
            "sach main",
            "sach me",
            "sachi"
          ],
          "kind": "phrase"
        },
        {
          "id": "p-chalo",
          "en": "Okay then / Let's go",
          "roman": "Chalo",
          "urdu": "چلو",
          "accept": [
            "chalo"
          ],
          "kind": "word"
        },
        {
          "id": "p-bas",
          "en": "Enough / That's it",
          "roman": "Bas",
          "urdu": "بس",
          "kind": "word"
        },
        {
          "id": "p-kya-haal",
          "en": "How's it going?",
          "roman": "Kya haal hai?",
          "urdu": "کیا حال ہے؟",
          "accept": [
            "kya hal hai",
            "kia haal hai",
            "kya haal he"
          ],
          "note": "Casual and friendly. A typical reply: \"Theek, aap sunayein?\"",
          "kind": "sentence"
        },
        {
          "id": "p-sab-theek",
          "en": "All good?",
          "roman": "Sab theek?",
          "urdu": "سب ٹھیک؟",
          "accept": [
            "sab thik"
          ],
          "kind": "phrase"
        },
        {
