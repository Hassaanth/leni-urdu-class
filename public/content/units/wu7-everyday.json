  "guide": [
    {
      "title": "Kal — yesterday AND tomorrow",
      "body": "Kal means both yesterday and tomorrow. The verb shows which one: you'll see this in the sentence lessons.",
      "examples": [
        "v-kal",
        "v-aaj"
      ]
    },
    {
      "title": "Describing words change a little",
      "body": "Words ending in -a often change to -i for feminine things: bara → bari, naya → nayi. You'll pick this up by hearing it.",
      "examples": [
        "v-bara",
        "v-naya"
      ]
    },
    {
      "title": "Directions",
      "body": "seedha (straight), daayen (right), baayen (left). You'll use them with the question word kahan (where).",
      "examples": [
        "v-seedha",
        "v-daayen",
        "v-baayen"
      ]
    }
  ]
