      "title": "You are… / Are you…?",
      "objective": "Ask how someone is, ask yes/no questions, and say \"not\".",
      "phrases": [
        {
          "id": "w-aap",
          "roman": "aap",
          "urdu": "آپ",
          "en": "you (polite)",
          "kind": "word",
          "note": "The respectful \"you\". Use it with everyone you don't know well — and all elders."
        },
        {
          "id": "w-hain",
          "roman": "hain",
          "urdu": "ہیں",
          "en": "are",
          "kind": "word",
          "note": "Goes with aap: aap … hain. Like hoon, it comes last."
