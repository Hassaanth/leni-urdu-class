          "accept": [
            "khudahafiz",
            "khuda hafis"
          ],
          "note": "The \"kh\" is a throaty sound (خ), like the end of Scottish \"loch\", not an English k.",
          "kind": "phrase"
        },
        {
          "id": "p-allah-hafiz",
          "en": "Goodbye (also very common)",
          "roman": "Allah hafiz",
