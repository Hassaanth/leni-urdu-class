{
  "id": "u1",
  "level": 1,
  "title": "Greetings & Introductions",
  "description": "Say hello, introduce yourself, and get through your first conversation.",
  "lessons": [
    {
      "id": "l1-intro",
      "title": "Introducing Yourself",
      "objective": "Greet someone, ask their name, introduce yourself, and respond to a basic question.",
      "tips": [
        "Aap is the respectful word for \"you\". Use it with strangers, elders, and anyone you are not close to. It is never rude.",
        "Urdu usually puts the verb at the end: \"Mera naam Ali hai\" is literally \"My name Ali is\".",
        "Some words change with gender. \"Mera naam\" stays the same for everyone because it matches naam (name), not the speaker. \"Kaise\" becomes \"kaisi\" when you ask a woman."
      ],
      "phrases": [
        {
          "id": "p-salaam",
          "en": "Peace be upon you (hello)",
          "roman": "Assalamu alaikum",
          "urdu": "السلام علیکم",
          "accept": [
            "assalam o alaikum",
            "assalamualaikum",
            "asalam alaikum",
            "assalam alaikum",
            "salam alaikum",
            "asalamualaikum",
            "assalamu alaykum",
            "assalam-o-alaikum"
          ],
          "note": "The most common greeting in Pakistan, used at any time of day, with anyone. It is a religious greeting in origin, and it is used everywhere in daily life.",
          "kind": "phrase"
        },
        {
          "id": "p-walaikum",
          "en": "And peace be upon you too (reply to a greeting)",
          "roman": "Wa alaikum assalam",
          "urdu": "وعلیکم السلام",
          "accept": [
            "walaikum assalam",
            "wa alaikum salam",
            "walaikum salam",
            "waalaikum assalam",
            "wa alaykum assalam",
            "walaikumassalam",
            "wa alaikum as salam"
          ],
          "note": "The standard reply to \"Assalamu alaikum\". When someone greets you, reply with this rather than repeating their greeting.",
          "kind": "phrase"
        },
        {
          "id": "p-naam-kya",
          "en": "What is your name?",
          "roman": "Aap ka naam kya hai?",
          "urdu": "آپ کا نام کیا ہے؟",
          "accept": [
            "aapka naam kya hai",
            "aap ka naam kia hai",
            "aap ka nam kya hai"
          ],
          "literal": "your name what is",
          "note": "\"Aap ka\" means \"your\" (respectful). \"Kya\" means \"what\". With a close friend you might hear \"Tumhara naam kya hai?\", but \"aap ka\" is the safe choice.",
          "kind": "sentence"
        },
        {
          "id": "p-mera-naam",
          "en": "My name is {name}.",
          "roman": "Mera naam {name} hai.",
          "urdu": "میرا نام {name} ہے۔",
          "slot": "name",
          "literal": "my name [name] is",
          "note": "Everyone says \"mera naam\", whether the speaker is a man or a woman, because \"mera\" agrees with \"naam\" (a masculine word), not with you.",
          "kind": "sentence"
        },
        {
          "id": "p-kaise-hain",
          "en": "How are you?",
          "roman": "Aap kaise hain?",
          "urdu": "آپ کیسے ہیں؟",
          "accept": [
            "aap kese hain",
            "aap kaisay hain",
            "ap kaise hain"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Aap kaise hain?",
              "urdu": "آپ کیسے ہیں؟"
            },
            "feminine": {
              "roman": "Aap kaisi hain?",
              "urdu": "آپ کیسی ہیں؟"
            },
            "explain": "This depends on who you are asking: \"kaise\" when asking a man (or a group), \"kaisi\" when asking a woman.",
            "by": "listener"
          },
          "kind": "sentence"
        },
        {
          "id": "p-theek-hoon",
          "en": "I am fine.",
          "roman": "Main theek hoon.",
          "urdu": "میں ٹھیک ہوں۔",
          "accept": [
            "mein theek hoon",
            "main thik hoon",
            "main theek hun",
            "mai theek hoon",
            "main theek hu"
          ],
          "note": "\"Theek\" (fine, okay) does not change for gender, so men and women both say \"Main theek hoon\". The \"th\" here is a retroflex t with a puff of air, not the English \"th\" in \"think\".",
          "kind": "sentence"
        },
        {
          "id": "p-aap-sunayein",
          "en": "And how about you? (lit. you tell me?)",
          "roman": "Aap sunayein?",
          "urdu": "آپ سنائیں؟",
          "accept": [
            "aap sunaen",
            "aap sunaiye",
            "aap sunain",
            "aap sunayen",
            "aap sunaein",
            "ap sunayein"
          ],
          "note": "A very common, friendly way to bounce the question back. Literally \"you tell (me)\". With close friends people say the informal \"Tum sunao?\".",
          "kind": "phrase"
        },
        {
          "id": "p-mil-kar-khushi",
          "en": "Nice to meet you.",
          "roman": "Aapse mil kar khushi hui.",
          "urdu": "آپ سے مل کر خوشی ہوئی۔",
          "accept": [
            "aap se mil kar khushi hui",
            "aapse milkar khushi hui",
            "aap se mil ke khushi hui",
            "aapse mil ke khushi hui"
          ],
          "literal": "having met you, happiness happened",
          "note": "\"Hui\" agrees with \"khushi\" (happiness, a feminine word), so this phrase is the same for every speaker.",
          "kind": "sentence"
        },
        {
          "id": "p-main-bhi-theek",
          "en": "I'm fine too.",
          "roman": "Main bhi theek hoon.",
          "urdu": "میں بھی ٹھیک ہوں۔",
          "accept": [
            "mein bhi theek hoon",
            "main bhi thik hoon",
            "main bhi theek hun"
          ],
          "note": "\"Bhi\" means \"also, too\". It comes right after the word it refers to.",
          "kind": "sentence"
        },
        {
          "id": "p-ji-haan",
          "en": "Yes (polite)",
          "roman": "Ji haan",
          "urdu": "جی ہاں",
          "accept": [
            "jee haan",
            "ji han",
            "ji ha"
          ],
          "note": "\"Ji\" makes things polite. \"Ji\" alone is also a polite \"yes\" or \"I'm listening\".",
          "kind": "phrase"
        }
      ],
