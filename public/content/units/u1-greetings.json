    {
      "id": "l1-survival",
      "title": "Survival Phrases",
      "objective": "Say when you don't understand, ask people to slow down, and ask for what you need.",
      "tips": [
        "\"Mujhe\" means \"to me\". Many Urdu feelings and needs are said this way: \"Mujhe paani chahiye\" is literally \"to me, water is needed\".",
        "These phrases are your safety net. If you remember only a few, remember \"Aahista boliye\" and \"Mujhe samajh nahi aaya\"."
      ],
      "phrases": [
        {
          "id": "p-samajh-nahi",
          "en": "I didn't understand.",
          "roman": "Mujhe samajh nahi aaya.",
          "urdu": "مجھے سمجھ نہیں آیا۔",
          "accept": [
            "mujhe samajh nahin aaya",
            "mujhe samajh nahi aya",
            "mujhe samajh nahi aai",
            "mujhe samajh nahi ayi",
            "mjhe samajh nahi aaya"
          ],
          "literal": "to me understanding didn't come",
          "note": "Used the moment you don't follow what someone said. You will also hear \"samajh nahi aayi\"; both are common.",
          "kind": "sentence"
        },
        {
          "id": "p-aahista",
          "en": "Please speak slowly.",
          "roman": "Aahista boliye.",
          "urdu": "آہستہ بولیے۔",
          "accept": [
            "ahista boliye",
            "aahista bolen",
            "aahista bolein",
            "aahista boliyega",
            "ahista bolain"
          ],
          "note": "\"Boliye\" is the polite \"please speak\". \"Aahista\" means slowly or softly.",
          "kind": "sentence"
        },
        {
          "id": "p-dobara",
          "en": "Please say that again.",
          "roman": "Dobara boliye.",
          "urdu": "دوبارہ بولیے۔",
          "accept": [
            "dobaara boliye",
            "dubara boliye",
            "dobara bolen",
            "dobara bolein"
          ],
          "kind": "sentence"
        },
        {
