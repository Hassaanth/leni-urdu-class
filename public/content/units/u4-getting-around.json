    {
      "id": "l4-time",
      "title": "Time & Days",
      "objective": "Ask the time and talk about today, tomorrow and parts of the day.",
      "tips": [
        "\"Kal\" means both yesterday and tomorrow! The verb tense tells you which.",
        "\"Baje\" means o'clock: \"Paanch baje\" = five o'clock."
      ],
      "phrases": [
        {
          "id": "p-kitne-baje",
          "en": "What time is it?",
          "roman": "Kitne baje hain?",
          "urdu": "کتنے بجے ہیں؟",
          "accept": [
            "kitne bajay hain",
            "kitne baje hai",
            "time kya hua hai"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-do-baje",
          "en": "It's two o'clock.",
          "roman": "Do baje hain.",
          "urdu": "دو بجے ہیں۔",
          "accept": [
            "do bajay hain"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-aaj",
          "en": "today",
