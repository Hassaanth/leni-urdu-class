    {
      "id": "l4-routine",
      "title": "Daily Routine & Likes",
      "objective": "Describe what you do every day and what you like or don't like.",
      "tips": [
        "Habit verbs end in -ta (men) or -ti (women): \"Main kaam par jaata hoon\" / \"Main kaam par jaati hoon\". This is your first speaker-gender pattern — pick the form that matches you.",
        "Likes use \"mujhe\": \"Mujhe cricket pasand hai\" (to me cricket is liked). This form doesn't change for gender."
      ],
      "phrases": [
        {
          "id": "p-jaldi-uthta",
          "en": "I get up early in the morning.",
          "roman": "Main subah jaldi uthta hoon.",
          "urdu": "میں صبح جلدی اٹھتا ہوں۔",
          "accept": [
            "main subha jaldi uthta hoon",
            "mein subah jaldi uthta hoon"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Main subah jaldi uthta hoon.",
              "urdu": "میں صبح جلدی اٹھتا ہوں۔"
            },
            "feminine": {
              "roman": "Main subah jaldi uthti hoon.",
              "urdu": "میں صبح جلدی اٹھتی ہوں۔"
            },
            "explain": "Men say \"uthta\", women say \"uthti\". The verb matches the speaker.",
            "by": "speaker"
          },
          "kind": "sentence"
        },
        {
          "id": "p-kaam-par",
          "en": "I go to work.",
          "roman": "Main kaam par jaata hoon.",
          "urdu": "میں کام پر جاتا ہوں۔",
          "accept": [
            "main kaam pe jaata hoon",
            "main kam par jata hoon",
            "main kaam par jata hun"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Main kaam par jaata hoon.",
              "urdu": "میں کام پر جاتا ہوں۔"
            },
            "feminine": {
              "roman": "Main kaam par jaati hoon.",
              "urdu": "میں کام پر جاتی ہوں۔"
            },
            "explain": "\"Jaata\" for a male speaker, \"jaati\" for a female speaker.",
            "by": "speaker"
          },
          "kind": "sentence"
        },
        {
          "id": "p-cricket",
          "en": "I like cricket.",
          "roman": "Mujhe cricket pasand hai.",
          "urdu": "مجھے کرکٹ پسند ہے۔",
          "accept": [
            "mujhe cricket pasand he"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-pasand-nahi",
          "en": "I don't like this.",
          "roman": "Mujhe yeh pasand nahi.",
          "urdu": "مجھے یہ پسند نہیں۔",
          "accept": [
            "mujhe ye pasand nahi",
            "mujhe yeh pasand nahin",
            "mujhe yeh pasand nahi hai"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-kya-pasand",
          "en": "What do you like?",
          "roman": "Aap ko kya pasand hai?",
          "urdu": "آپ کو کیا پسند ہے؟",
          "accept": [
            "aapko kya pasand hai",
            "ap ko kya pasand hai"
          ],
          "kind": "sentence"
        },
        {
          "id": "p-thak-gaya",
          "en": "I'm tired.",
          "roman": "Main thak gaya hoon.",
          "urdu": "میں تھک گیا ہوں۔",
          "accept": [
            "main thak gaya hun",
            "mein thak gaya hoon"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Main thak gaya hoon.",
              "urdu": "میں تھک گیا ہوں۔"
            },
            "feminine": {
              "roman": "Main thak gayi hoon.",
              "urdu": "میں تھک گئی ہوں۔"
            },
            "explain": "\"Gaya\" for men, \"gayi\" for women.",
            "by": "speaker"
          },
          "kind": "sentence"
        },
        {
          "id": "p-neend",
          "en": "I'm sleepy.",
          "roman": "Mujhe neend aa rahi hai.",
          "urdu": "مجھے نیند آ رہی ہے۔",
          "accept": [
