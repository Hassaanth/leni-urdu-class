  "lessons": [
    {
      "id": "l4-directions",
      "title": "Directions",
      "objective": "Ask where something is and understand simple directions.",
      "tips": [
        "Many Pakistanis use the English words \"right\" and \"left\" in directions. Learn daayen and baayen anyway so you can understand them.",
        "\"Jaayen\" and \"murein\" are polite commands: go, turn."
      ],
      "phrases": [
        {
          "id": "p-masjid-kahan",
          "en": "Where is the mosque?",
          "roman": "Masjid kahan hai?",
          "urdu": "مسجد کہاں ہے؟",
          "accept": [
            "masjid kahaan hai",
            "masjid kahan he"
          ],
          "note": "Swap in any place: \"Bazaar kahan hai?\", \"Hotel kahan hai?\"",
          "kind": "sentence"
        },
        {
          "id": "p-washroom",
          "en": "Where is the washroom?",
          "roman": "Washroom kahan hai?",
          "urdu": "واش روم کہاں ہے؟",
          "accept": [
            "bathroom kahan hai",
            "washroom kahaan hai"
          ],
          "note": "\"Washroom\" is the usual word in Pakistan.",
          "kind": "sentence"
        },
        {
          "id": "p-seedha",
          "en": "straight",
          "roman": "seedha",
          "urdu": "سیدھا",
          "accept": [
            "sidha",
