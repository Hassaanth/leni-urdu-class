          "urdu": "آج",
          "accept": [
            "aj"
          ],
          "kind": "word"
        },
        {
          "id": "p-kal",
          "en": "tomorrow / yesterday",
          "roman": "kal",
          "urdu": "کل",
          "kind": "word"
        },
        {
          "id": "p-subah",
