      "dialogue": {
        "title": "Khala asks about the family",
        "partner": {
          "name": "Khala",
          "voice": "f"
        },
        "lines": [
          {
            "who": "them",
            "roman": "Aap ke kitne behen bhai hain?",
            "urdu": "آپ کے کتنے بہن بھائی ہیں؟",
            "en": "How many brothers and sisters do you have?"
          },
          {
            "who": "you",
            "roman": "Mere do bhai hain aur ek behen.",
            "urdu": "میرے دو بھائی ہیں اور ایک بہن۔",
            "en": "I have two brothers and one sister."
          },
          {
            "who": "them",
            "roman": "Masha'Allah! Aur ammi abbu kaise hain?",
            "urdu": "ماشاءاللہ! اور امی ابو کیسے ہیں؟",
            "en": "Wonderful! And how are your mum and dad?"
          },
          {
            "who": "you",
            "roman": "Woh theek hain, shukriya.",
            "urdu": "وہ ٹھیک ہیں، شکریہ۔",
            "en": "They're fine, thank you."
          },
          {
            "who": "them",
            "roman": "Nani ko mera salaam kehna.",
            "urdu": "نانی کو میرا سلام کہنا۔",
            "en": "Give my regards to Nani."
          }
        ]
      }
