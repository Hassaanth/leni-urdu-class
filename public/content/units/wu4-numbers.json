  "guide": [
    {
      "title": "Counting",
      "body": "Numbers go before things, like English: do chai = two teas.",
      "examples": [
        "v-ek",
        "v-do",
        "v-paanch"
      ]
    },
    {
      "title": "Hundreds",
      "body": "Put a number before sau: paanch sau = five hundred. Prices end with rupay.",
      "examples": [
        "v-sau",
        "v-rupay"
      ]
    },
    {
      "title": "Cheap or expensive?",
      "body": "In a bazaar you'll hear mehenga (expensive) a lot — usually from the customer!",
      "examples": [
        "v-sasta",
        "v-mehenga"
      ]
    }
