  "guide": [
    {
      "title": "Endings come last",
      "body": "hoon (am), hai (is), hain (are) go at the END: \"I happy am\". You'll start building these sentences in the next level.",
      "examples": [
        "v-hoon",
        "v-hai"
      ]
    },
    {
      "title": "Mujhe + chahiye",
      "body": "Urdu says \"to me, water is needed\" instead of \"I want water\". mujhe = to me, chahiye = needed.",
      "examples": [
        "v-mujhe",
        "v-chahiye"
      ]
    },
    {
      "title": "Action roots",
      "body": "kha (eat), pee (drink), ja (go), aa (come), kar (do), bol (speak), seekh (learn) are roots. Endings are added for \"I'm eating\", \"I ate\", \"I will eat\".",
      "examples": [
        "v-kha",
        "v-ja",
        "v-bol"
      ]
    }
  ]
}
