  "host": "zara",
  "chapter": "Chapter 12 · Real conversations: questions & people",
  "story": "Zara wants to count everything and know everyone. Answer her questions in full conversations.",
  "guide": [
    {
      "title": "Question words start with \"k\"",
      "body": "kya (what), kaun (who), kahan (where), kab (when), kyun (why), kaise (how). Put the question word where the answer would go: Aap kahan se hain? → Main London se hoon.",
      "examples": [
        "p-kahan-se",
        "p-yeh-kya"
      ]
    },
    {
      "title": "Yes/no questions",
      "body": "Put Kya at the very start of a sentence to turn it into a yes/no question — like \"Do…?\" in English.",
      "examples": [
        "p-english-bolte",
        "p-door-hai"
      ]
    },
    {
      "title": "Every noun is masculine or feminine",
      "body": "Words that describe a noun change to match it. A male friend is mera dost, a female friend is meri dost. You'll pick these up by hearing them — don't try to memorise lists.",
      "examples": [
        "p-mera-dost",
        "p-hum-dost"
      ]
    },
    {
      "title": "Counting",
      "body": "Numbers come before the thing: do bhai (two brothers), paanch minute (five minutes).",
      "examples": [
        "p-ek",
        "p-paanch",
        "p-das"
      ]
    }
  ]
}
