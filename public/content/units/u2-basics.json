    {
      "id": "l2-people",
      "title": "People & Pronouns",
      "objective": "Use I, you, we, he/she, and introduce a friend.",
      "tips": [
        "Urdu has three \"you\"s: aap (respectful), tum (friends, younger people) and tu (very intimate or rude — avoid it as a beginner).",
        "\"Yeh\" (this, he/she nearby) and \"woh\" (that, he/she further away) don't show gender. The verb or adjective often does."
      ],
      "phrases": [
        {
          "id": "p-main",
          "en": "I",
          "roman": "main",
          "urdu": "میں",
          "accept": [
            "mein",
            "mai"
          ],
          "note": "Nasal ending: \"main\" sounds close to \"meh\" with air through the nose.",
          "kind": "word"
        },
        {
          "id": "p-aap",
          "en": "you (respectful)",
          "roman": "aap",
          "urdu": "آپ",
          "accept": [
            "ap"
          ],
          "kind": "word"
        },
        {
          "id": "p-tum",
          "en": "you (informal, friends)",
          "roman": "tum",
          "urdu": "تم",
          "kind": "word"
        },
        {
          "id": "p-hum",
          "en": "we",
          "roman": "hum",
          "urdu": "ہم",
          "kind": "word"
        },
        {
          "id": "p-yeh",
          "en": "this / he / she (near)",
          "roman": "yeh",
          "urdu": "یہ",
          "accept": [
            "ye",
            "yah"
          ],
          "kind": "word"
        },
        {
          "id": "p-woh",
          "en": "that / he / she (far)",
          "roman": "woh",
          "urdu": "وہ",
          "accept": [
            "wo",
            "vo",
            "voh"
          ],
          "kind": "word"
        },
        {
          "id": "p-dost",
          "en": "friend",
          "roman": "dost",
          "urdu": "دوست",
          "kind": "word"
        },
        {
          "id": "p-larka",
          "en": "boy",
          "roman": "larka",
          "urdu": "لڑکا",
          "accept": [
            "ladka",
            "larrka"
          ],
          "note": "The \"r\" here is ڑ, a flap with the tongue curled back. Some people write it as \"d\": ladka.",
          "kind": "word"
        },
        {
          "id": "p-larki",
          "en": "girl",
          "roman": "larki",
          "urdu": "لڑکی",
          "accept": [
            "ladki"
          ],
          "kind": "word"
        },
        {
          "id": "p-mera-dost",
          "en": "This is my friend.",
          "roman": "Yeh mera dost hai.",
          "urdu": "یہ میرا دوست ہے۔",
          "accept": [
            "ye mera dost hai",
            "yeh mera dost he"
          ],
          "genderVariants": {
            "masculine": {
              "roman": "Yeh mera dost hai.",
              "urdu": "یہ میرا دوست ہے۔"
            },
            "feminine": {
              "roman": "Yeh meri dost hai.",
              "urdu": "یہ میری دوست ہے۔"
            },
            "explain": "This depends on the friend, not on you: \"mera dost\" for a male friend, \"meri dost\" for a female friend.",
            "by": "listener"
          },
          "kind": "sentence"
        },
        {
          "id": "p-hum-dost",
          "en": "We are friends.",
          "roman": "Hum dost hain.",
          "urdu": "ہم دوست ہیں۔",
          "accept": [
            "hum dost hein",
            "ham dost hain"
          ],
          "kind": "sentence"
        }
      ],
