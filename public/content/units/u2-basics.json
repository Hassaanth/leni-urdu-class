          {
            "who": "them",
            "roman": "Theek hai. Ek, do, teen, chaar, paanch!",
            "urdu": "ٹھیک ہے۔ ایک، دو، تین، چار، پانچ!",
            "en": "Okay. One, two, three, four, five!"
          }
        ]
      }
