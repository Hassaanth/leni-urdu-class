  "title": "Numbers, People & Questions",
  "description": "Count to ten, talk about people, and ask the key question words.",
  "lessons": [
    {
      "id": "l2-numbers",
      "title": "Numbers 1–10",
      "objective": "Count from one to ten and ask \"how many?\".",
      "tips": [
        "Long vowels matter: \"chaar\" (four) has a long \"aa\". Hold it a little longer than an English \"a\".",
        "\"Aath\" (eight) ends in a retroflex t with a puff of air: curl your tongue tip back slightly."
      ],
      "phrases": [
        {
          "id": "p-ek",
          "en": "one",
          "roman": "ek",
          "urdu": "ایک",
          "accept": [
            "aik",
            "ik"
          ],
          "kind": "word"
        },
        {
          "id": "p-do",
          "en": "two",
          "roman": "do",
          "urdu": "دو",
          "kind": "word"
        },
        {
          "id": "p-teen",
          "en": "three",
          "roman": "teen",
          "urdu": "تین",
          "accept": [
            "tin"
          ],
          "note": "A soft dental t: the tongue touches the back of your top teeth.",
          "kind": "word"
        },
        {
          "id": "p-chaar",
          "en": "four",
          "roman": "chaar",
          "urdu": "چار",
          "accept": [
