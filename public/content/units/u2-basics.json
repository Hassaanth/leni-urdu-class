    {
      "id": "l2-questions",
      "title": "Question Words",
      "objective": "Ask who, what, where, when, why and how — and say where you are from.",
      "tips": [
        "Most question words start with k: kya, kaun, kahan, kab, kyun, kaise, kitna.",
        "The question word usually goes where the answer would go: \"Aap kahan se hain?\" → \"Main London se hoon.\""
      ],
      "phrases": [
        {
          "id": "p-kya",
          "en": "what?",
          "roman": "kya?",
          "urdu": "کیا؟",
          "accept": [
            "kia",
            "kiya"
          ],
          "kind": "word"
        },
        {
          "id": "p-kaun",
          "en": "who?",
          "roman": "kaun?",
          "urdu": "کون؟",
          "accept": [
            "kon",
            "kaon"
          ],
          "kind": "word"
        },
        {
          "id": "p-kahan",
          "en": "where?",
          "roman": "kahan?",
          "urdu": "کہاں؟",
          "accept": [
            "kahaan",
            "kahan"
          ],
          "kind": "word"
        },
        {
          "id": "p-kab",
          "en": "when?",
          "roman": "kab?",
          "urdu": "کب؟",
          "kind": "word"
        },
        {
          "id": "p-kyun",
          "en": "why?",
          "roman": "kyun?",
          "urdu": "کیوں؟",
          "accept": [
            "kyon",
            "kiyun",
            "kyu"
          ],
          "kind": "word"
        },
        {
          "id": "p-kaise",
          "en": "how?",
          "roman": "kaise?",
          "urdu": "کیسے؟",
          "accept": [
            "kese",
            "kaisay"
          ],
          "kind": "word"
        },
        {
          "id": "p-kaun-sa",
          "en": "which one?",
          "roman": "kaun sa?",
          "urdu": "کون سا؟",
          "accept": [
            "kon sa",
            "konsa",
            "kaunsa"
          ],
          "note": "Becomes \"kaun si\" for feminine things: \"kaun si kitaab?\" (which book?)",
          "kind": "phrase"
        },
        {
          "id": "p-kahan-se",
          "en": "Where are you from?",
          "roman": "Aap kahan se hain?",
          "urdu": "آپ کہاں سے ہیں؟",
          "accept": [
            "aap kahaan se hain",
            "ap kahan se hain",
            "aap kahan se hein"
          ],
          "literal": "you where from are",
          "kind": "sentence"
        },
        {
          "id": "p-london-se",
          "en": "I'm from London.",
          "roman": "Main London se hoon.",
          "urdu": "میں لندن سے ہوں۔",
          "accept": [
            "mein london se hoon",
            "main london se hun"
          ],
          "note": "Swap in your own city: \"Main Toronto se hoon\", \"Main Lahore se hoon\".",
          "kind": "sentence"
        },
        {
          "id": "p-yeh-kya",
          "en": "What is this?",
          "roman": "Yeh kya hai?",
          "urdu": "یہ کیا ہے؟",
          "accept": [
            "ye kya hai",
            "yeh kia hai",
            "ye kya he"
          ],
          "kind": "sentence"
        }
      ],
